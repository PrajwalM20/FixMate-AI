{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform user account with role and private contact fields.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 150 },
        "role": { "type": "string", "enum": ["customer", "technician", "admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 250 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "Technician": {
      "title": "Technician",
      "description": "Public professional technician profile, skills, service categories, and verification status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 1000 },
        "serviceCategories": { "type": "array", "description": "Bounded list of up to 10 appliance category slugs" },
        "skills": { "type": "array", "description": "Bounded list of up to 15 technical skills" },
        "experienceYears": { "type": "number" },
        "serviceArea": { "type": "string", "minLength": 1, "maxLength": 120 },
        "availabilityStatus": { "type": "string", "enum": ["available", "busy", "offline"] },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected", "suspended"] },
        "ratingAvg": { "type": "number" },
        "completedJobs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "serviceCategories",
        "skills",
        "experienceYears",
        "serviceArea",
        "availabilityStatus",
        "verificationStatus",
        "ratingAvg",
        "completedJobs",
        "createdAt",
        "updatedAt"
      ]
    },
    "RepairRequest": {
      "title": "RepairRequest",
      "description": "Customer appliance fault submission with symptoms and optional image URLs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "applianceCategory": {
          "type": "string",
          "enum": [
            "refrigerator",
            "washing_machine",
            "air_conditioner",
            "laptop",
            "television",
            "microwave",
            "other"
          ]
        },
        "applianceBrand": { "type": "string", "maxLength": 80 },
        "applianceModel": { "type": "string", "maxLength": 80 },
        "symptomSummary": { "type": "string", "minLength": 3, "maxLength": 300 },
        "symptomDetails": { "type": "string", "maxLength": 3000 },
        "imageUrls": { "type": "array", "description": "Up to 5 uploaded image URLs" },
        "status": {
          "type": "string",
          "enum": ["draft", "diagnosed", "technician_requested", "booked", "in_progress", "completed", "cancelled"]
        },
        "assignedTechnicianId": { "type": "string", "maxLength": 128 },
        "latestDiagnosisId": { "type": "string", "maxLength": 128 },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "customerId",
        "customerName",
        "applianceCategory",
        "symptomSummary",
        "symptomDetails",
        "imageUrls",
        "status",
        "riskLevel",
        "createdAt",
        "updatedAt"
      ]
    },
    "Diagnosis": {
      "title": "Diagnosis",
      "description": "Structured hybrid AI diagnostic output with inference trace, BFS path, uncertainty scores, and follow-up dialogue.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "applianceCategory": { "type": "string", "minLength": 2, "maxLength": 60 },
        "observations": { "type": "array", "description": "Up to 25 extracted symptom observations" },
        "imageObservations": { "type": "array", "description": "Up to 15 visible features extracted from images" },
        "userSymptoms": { "type": "array", "description": "Up to 20 user-reported symptoms" },
        "imageUrls": { "type": "array", "description": "Up to 5 uploaded image references" },
        "matchedKnowledgeIds": { "type": "array", "description": "Up to 15 matched knowledge base rule/entry IDs" },
        "hypotheses": { "type": "array", "description": "Up to 10 ranked diagnostic hypotheses with uncertainty metadata" },
        "followUpQuestions": { "type": "array", "description": "Up to 10 suggested diagnostic questions" },
        "missingEvidence": { "type": "array", "description": "Up to 15 missing observations" },
        "contradictoryEvidence": { "type": "array", "description": "Up to 10 contradictory cues" },
        "inferenceTrace": { "type": "array", "description": "Up to 25 forward-chaining rule steps" },
        "bfsSearchPath": { "type": "array", "description": "Up to 20 BFS selected troubleshooting path nodes" },
        "bfsExploredLevels": { "type": "array", "description": "Up to 10 BFS exploration levels" },
        "recommendedSteps": { "type": "array", "description": "Up to 15 safe troubleshooting steps" },
        "safetyWarnings": { "type": "array", "description": "Up to 10 active safety warnings" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "urgencyLevel": { "type": "string", "enum": ["routine", "soon", "urgent", "emergency"] },
        "nextRecommendedAction": {
          "type": "string",
          "enum": [
            "safe_external_checks",
            "ask_follow_up_questions",
            "continue_diagnosis",
            "stop_using_appliance",
            "contact_qualified_technician"
          ]
        },
        "confidenceScore": { "type": "number" },
        "requiresProfessional": { "type": "boolean" },
        "engineMode": { "type": "string", "enum": ["phase1_deterministic_stub", "gemini_hybrid"] },
        "summary": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "followUpConversation": { "type": "array", "description": "Up to 30 follow-up Q&A turns" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "requestId",
        "customerId",
        "applianceCategory",
        "observations",
        "matchedKnowledgeIds",
        "hypotheses",
        "recommendedSteps",
        "riskLevel",
        "confidenceScore",
        "requiresProfessional",
        "engineMode",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Scheduled repair visit connecting a customer and a verified technician with state-machine lifecycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "diagnosisId": { "type": "string", "maxLength": 128 },
        "diagnosisSharedWithPermission": { "type": "boolean" },
        "sharedDiagnosisSummary": { "type": "string", "maxLength": 2000 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "technicianName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "applianceCategory": { "type": "string", "minLength": 2, "maxLength": 60 },
        "scheduledDate": { "type": "string", "minLength": 8, "maxLength": 40 },
        "timeSlot": { "type": "string", "minLength": 3, "maxLength": 60 },
        "slotKey": { "type": "string", "maxLength": 128 },
        "serviceAddress": { "type": "string", "minLength": 5, "maxLength": 250 },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "pending",
            "accepted",
            "rejected",
            "quotation_submitted",
            "confirmed",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "notes": { "type": "string", "maxLength": 1000 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "requestId",
        "customerId",
        "technicianId",
        "customerName",
        "technicianName",
        "applianceCategory",
        "scheduledDate",
        "timeSlot",
        "serviceAddress",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingSlotLock": {
      "title": "BookingSlotLock",
      "description": "Atomic technician date/time-slot reservation lock preventing double booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scheduledDate": { "type": "string", "minLength": 8, "maxLength": 40 },
        "timeSlot": { "type": "string", "minLength": 3, "maxLength": 60 },
        "status": { "type": "string", "enum": ["reserved", "released"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "technicianId", "customerId", "scheduledDate", "timeSlot", "status", "createdAt", "updatedAt"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Itemized technician repair cost estimate submitted for a customer repair request or booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianName": { "type": "string", "maxLength": 100 },
        "laborCharge": { "type": "number" },
        "partsCost": { "type": "number" },
        "additionalCharges": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "INR"] },
        "estimatedCompletionTime": { "type": "string", "maxLength": 100 },
        "proposedWorkDescription": { "type": "string", "maxLength": 1000 },
        "partsDescription": { "type": "string", "minLength": 2, "maxLength": 500 },
        "laborDescription": { "type": "string", "minLength": 2, "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "requestId",
        "customerId",
        "technicianId",
        "estimatedCost",
        "currency",
        "partsDescription",
        "laborDescription",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer rating and optional technician response after a completed repair booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "technicianResponse": { "type": "string", "maxLength": 800 },
        "technicianRespondedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bookingId", "customerId", "technicianId", "customerName", "rating", "comment", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-targeted notification record with relational sender linkage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "maxLength": 128 },
        "relatedBookingId": { "type": "string", "maxLength": 128 },
        "relatedRequestId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "message": { "type": "string", "minLength": 2, "maxLength": 500 },
        "type": { "type": "string", "enum": ["info", "diagnosis", "booking", "quotation", "review", "verification", "alert"] },
        "read": { "type": "boolean" },
        "linkPath": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Customer or technician dispute/complaint report managed by admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "reporterRole": { "type": "string", "enum": ["customer", "technician", "admin"] },
        "bookingId": { "type": "string", "maxLength": 128 },
        "technicianId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["service_quality", "pricing_dispute", "safety_concern", "no_show", "other"] },
        "subject": { "type": "string", "minLength": 3, "maxLength": 180 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved", "dismissed"] },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "reporterName", "reporterRole", "category", "subject", "description", "status", "createdAt", "updatedAt"]
    },
    "ApplianceCategory": {
      "title": "ApplianceCategory",
      "description": "Supported household or electronic appliance category metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 5, "maxLength": 500 },
        "commonFaultsCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "safetyNotice": { "type": "string", "minLength": 5, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "name", "description", "commonFaultsCount", "isActive", "safetyNotice", "createdAt", "updatedAt"]
    },
    "KnowledgeBaseEntry": {
      "title": "KnowledgeBaseEntry",
      "description": "Structured appliance fault representation for inference and troubleshooting search.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "applianceCategory": { "type": "string", "minLength": 2, "maxLength": 60 },
        "faultTitle": { "type": "string", "minLength": 3, "maxLength": 160 },
        "observableSymptoms": { "type": "array", "description": "Up to 20 observable symptoms" },
        "possibleCauses": { "type": "array", "description": "Up to 15 root causes" },
        "followUpQuestions": { "type": "array", "description": "Up to 10 diagnostic questions" },
        "safeTroubleshootingSteps": { "type": "array", "description": "Up to 15 safe DIY checks" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "requiresProfessional": { "type": "boolean" },
        "isSampleData": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "applianceCategory",
        "faultTitle",
        "observableSymptoms",
        "possibleCauses",
        "followUpQuestions",
        "safeTroubleshootingSteps",
        "riskLevel",
        "requiresProfessional",
        "isSampleData",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Support or contact form submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 150 },
        "subject": { "type": "string", "minLength": 3, "maxLength": 180 },
        "message": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["new", "reviewed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subject", "message", "status", "createdAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authoritative admin membership document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account profiles with strict owner/admin read and write isolation."
    },
    "/technicians/{technicianId}": {
      "schema": { "$ref": "#/entities/Technician" },
      "description": "Public technician profiles; verificationStatus is writable only by admins."
    },
    "/repairRequests/{requestId}": {
      "schema": { "$ref": "#/entities/RepairRequest" },
      "description": "Customer repair requests scoped to owner, assigned technician, and admins."
    },
    "/diagnoses/{diagnosisId}": {
      "schema": { "$ref": "#/entities/Diagnosis" },
      "description": "Diagnostic outputs referencing repairRequests and owned by customer."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Repair visit bookings shared strictly between customerId, technicianId, and admins."
    },
    "/bookingSlots/{slotKey}": {
      "schema": { "$ref": "#/entities/BookingSlotLock" },
      "description": "Atomic slot reservation locks keyed by technicianId, date, and timeSlot."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/Quotation" },
      "description": "Repair quotations shared strictly between customerId, technicianId, and admins."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified customer reviews keyed per booking with optional technician responses."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Per-user notifications readable and markable-as-read only by recipient."
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Customer and technician dispute/complaint records managed by admins."
    },
    "/applianceCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/ApplianceCategory" },
      "description": "Supported appliance categories readable publicly, writable only by admins."
    },
    "/knowledgeBase/{entryId}": {
      "schema": { "$ref": "#/entities/KnowledgeBaseEntry" },
      "description": "Structured appliance fault knowledge base readable publicly, writable only by admins."
    },
    "/contactInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ContactInquiry" },
      "description": "Support or contact form submission writable by users/visitors and readable by admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Authoritative admin role lookup collection."
    }
  }
}
